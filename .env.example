# Argus — environment variables (copy to .env.local)

# NVIDIA Nemotron (hosted NIM API, OpenAI-compatible)
# Get a key from https://build.nvidia.com (or your NVIDIA account API keys)
NVIDIA_API_KEY=
# Optional overrides:
# Model IDs on hosted NIM carry a vendor prefix — use the full ID from the catalog
# (GET https://integrate.api.nvidia.com/v1/models). Default is nemotron-3-ultra-550b-a55b.
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning toggle (Ultra is a thinking model): set "false" for the fast path
# NVIDIA_THINKING=true
# Total output cap — if NIM counts reasoning inside it, lowering bounds latency
# NVIDIA_MAX_OUTPUT_TOKENS=2048
# Chat model for the Ask-Argus box (small + thinking disabled by default)
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#
# OpenRouter swap (same app, zero code changes):
#   NVIDIA_BASE_URL=https://openrouter.ai/api/v1
#   NVIDIA_API_KEY=<openrouter key>
#   NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b:free
# (thinking stays governed by NVIDIA_THINKING; provider is pinned to NVIDIA
#  so the track's Nemotron-on-NVIDIA story stays accurate)

# SEC EDGAR (optional but polite — EDGAR logs User-Agent; include a contact)
# SEC_USER_AGENT=Argus-hackathon contact@argus.dev